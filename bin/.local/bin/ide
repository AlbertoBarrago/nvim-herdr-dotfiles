#!/bin/sh

set -eu

if [ "${HERDR_ENV:-}" != "1" ]; then
	printf '%s\n' "ide must be run from a Herdr pane." >&2
	exit 1
fi

agent=codex
project_dir=

while [ "$#" -gt 0 ]; do
	case "$1" in
		--agent)
			if [ "$#" -lt 2 ]; then
				printf '%s\n' "Missing value for --agent." >&2
				exit 2
			fi
			agent=$2
			shift 2
			;;
		--agent=*)
			agent=${1#--agent=}
			shift
			;;
		-h | --help)
			printf 'Usage: %s [--agent codex|claude] [project-directory]\n' "$0"
			exit 0
			;;
		-*)
			printf 'Unknown option: %s\n' "$1" >&2
			exit 2
			;;
		*)
			if [ -n "$project_dir" ]; then
				printf '%s\n' "Only one project directory can be provided." >&2
				exit 2
			fi
			project_dir=$1
			shift
			;;
	esac
done

case "$agent" in
	codex | claude) ;;
	*)
		printf 'Unsupported agent: %s (expected codex or claude)\n' "$agent" >&2
		exit 2
		;;
esac

for dependency in herdr jq nvim "$agent"; do
	if ! command -v "$dependency" >/dev/null 2>&1; then
		printf 'Missing dependency: %s\n' "$dependency" >&2
		exit 1
	fi
done

project_dir=${project_dir:-"$PWD"}
if [ ! -d "$project_dir" ]; then
	printf 'Not a directory: %s\n' "$project_dir" >&2
	exit 1
fi

project_dir=$(cd "$project_dir" && pwd -P)
workspace_label=$(basename "$project_dir")
workspace_id=
created_tab_id=
created_workspace=false

cleanup() {
	exit_code=$?
	trap - EXIT INT TERM
	if [ "$exit_code" -ne 0 ]; then
		if [ -n "$created_tab_id" ]; then
			herdr tab close "$created_tab_id" >/dev/null 2>&1 || true
		elif [ "$created_workspace" = true ] && [ -n "$workspace_id" ]; then
			herdr workspace close "$workspace_id" >/dev/null 2>&1 || true
		fi
	fi
	exit "$exit_code"
}
trap cleanup EXIT INT TERM

existing_workspace_id=$(herdr workspace list | jq -er --arg label "$workspace_label" \
	'.result.workspaces[] | select(.label == $label) | .workspace_id' 2>/dev/null | head -n1 || true)

if [ -n "$existing_workspace_id" ]; then
	workspace_id=$existing_workspace_id
	tab_json=$(herdr tab create \
		--workspace "$workspace_id" \
		--cwd "$project_dir" \
		--label "$workspace_label" \
		--env "HERDR_NVIM_AGENT=$agent" \
		--env 'HERDR_NVIM_AGENT_ARGS_JSON=[]' \
		--no-focus)

	created_tab_id=$(printf '%s' "$tab_json" | jq -er '.result.tab.tab_id')
	editor_pane=$(printf '%s' "$tab_json" | jq -er '.result.root_pane.pane_id')
else
	workspace_json=$(herdr workspace create \
		--cwd "$project_dir" \
		--label "$workspace_label" \
		--env "HERDR_NVIM_AGENT=$agent" \
		--env 'HERDR_NVIM_AGENT_ARGS_JSON=[]' \
		--no-focus)
	created_workspace=true

	workspace_id=$(printf '%s' "$workspace_json" | jq -er '.result.workspace.workspace_id')
	editor_pane=$(printf '%s' "$workspace_json" | jq -er '.result.root_pane.pane_id')
fi

herdr pane split \
	--pane "$editor_pane" \
	--direction down \
	--ratio 0.85 \
	--cwd "$project_dir" \
	--no-focus >/dev/null

herdr pane run "$editor_pane" nvim >/dev/null

if [ -n "$created_tab_id" ]; then
	herdr tab focus "$created_tab_id" >/dev/null
fi
herdr workspace focus "$workspace_id" >/dev/null

trap - EXIT INT TERM
